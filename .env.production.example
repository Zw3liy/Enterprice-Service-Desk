DJANGO_SETTINGS_MODULE=ticketing.production_settings
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=service-desk.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://service-desk.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_DB_SSL_REQUIRE=true
DATABASE_URL=postgresql://user:password@host:5432/service_desk
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media
DJANGO_LOG_LEVEL=INFO
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=service-desk@example.com
