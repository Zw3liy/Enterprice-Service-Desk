def populate_ticket_numbers(apps, schema_editor):
    """Assign deterministic numbers to records created before Phase 3."""
    Ticket = apps.get_model("ticketing", "Ticket")
    for ticket in Ticket.objects.filter(ticket_number__isnull=True).iterator():
        Ticket.objects.filter(pk=ticket.pk).update(ticket_number=f"ESD-{ticket.pk:07d}")


def reverse_populate_ticket_numbers(apps, schema_editor):
    """Ticket numbers are durable identifiers and are not removed on reverse."""


