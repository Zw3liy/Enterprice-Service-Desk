# Enterprise Service Desk — environment configuration example.
#
# Copy this file to .env and fill in real values for staging/production.
# .env itself is gitignored; this example file is intentionally tracked
# (see the "!.env.example" negation in .gitignore).
#
# Local development needs none of this — every variable below has a
# safe default that reproduces the previous hardcoded behavior when
# unset. Only set these for a real deployment.

# A long, random, secret string. Required whenever DJANGO_DEBUG is not
# enabled — the app will refuse to start without it in that case.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Defaults to true (matches the previous hardcoded DEBUG = True).
# Set to false for any real deployment.
DJANGO_DEBUG=false

# Comma-separated list of hostnames this deployment is served from.
# Defaults to "localhost,127.0.0.1".
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# Seconds to send the HTTP Strict-Transport-Security header for.
# Defaults to 0 (disabled). Only enable once HTTPS is fully working
# end-to-end — misconfiguring this can lock users out of the domain
# for a long time. A common starting value once ready: 3600 (1 hour),
# raised gradually toward the standard 31536000 (1 year).
DJANGO_SECURE_HSTS_SECONDS=0

# -------------------------------------------------------------------
# Email notifications
#
# The service desk writes an in-app Notification row for every event
# regardless of these settings — email is an optional mirror. Leaving
# DJANGO_EMAIL_NOTIFICATIONS unset (or false) means nothing is ever
# sent and no mail server is contacted, which is the correct state for
# local development and CI.
#
# Never commit real credentials to this file; it is tracked in Git.
# -------------------------------------------------------------------

# Master switch for outbound email. Defaults to false.
DJANGO_EMAIL_NOTIFICATIONS=false

# Defaults to the console backend, which prints mail to stdout instead
# of sending it. For real delivery:
#   django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true

# Seconds before an unresponsive mail server is given up on. Kept low
# on purpose: a hanging SMTP connection must not hold a web request
# open. Defaults to 10.
DJANGO_EMAIL_TIMEOUT=10

DJANGO_DEFAULT_FROM_EMAIL=service-desk@example.com
